# =====================================================================
# Pixellap Web — PRODUCTION environment (https://ppixelmedia.com)
# On the server this file lives at
#   /var/www/pixellap-web/shared/.env.production.local
# and deploy-web.sh links it into every release before `npm run build`.
# Values are read at BUILD time (next.config, prerendering) and at runtime:
# after changing one, run deploy-web.sh again (a reload alone is not enough).
# Never commit the real file.
# =====================================================================

# Public URL of the website, no trailing slash. Used for canonical URLs,
# sitemap.xml, robots.txt, Open Graph and JSON-LD. https:// also turns on
# the CSP "upgrade-insecure-requests" directive.
NEXT_PUBLIC_SITE_URL=https://ppixelmedia.com

# Laravel API base URL (server-side only — the browser never calls it).
# Its origin is also the only host allowed for images/media (CSP + next/image).
# provision.sh maps api.ppixelmedia.com to 127.0.0.1 in /etc/hosts, so these
# requests stay on the server.
API_URL=https://api.ppixelmedia.com/api/v1

# Shared secrets: must be IDENTICAL to API_SITE_KEY and REVALIDATE_SECRET in
# /var/www/pixellap-api/.env (at least 32 characters; openssl rand -hex 32).
# Server-only: never rename them to NEXT_PUBLIC_*.
API_SITE_KEY=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME

# Pre-launch mode (read at BUILD time): true = robots.txt disallows everything and every page
# gets <meta name="robots" content="noindex, nofollow">. Set false at go-live, then deploy-web.sh.
PRELAUNCH=true
