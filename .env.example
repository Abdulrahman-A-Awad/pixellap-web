# Public URL of this site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Laravel API base (pixellap-api)
API_URL=http://localhost:8000/api/v1
# Same value as API_SITE_KEY in pixellap-api/.env (server-only, never NEXT_PUBLIC_)
API_SITE_KEY=
# Same value as REVALIDATE_SECRET in pixellap-api/.env
REVALIDATE_SECRET=
# Pre-launch mode: noindex on every page + robots.txt disallows all (true/false, read at build)
PRELAUNCH=false
